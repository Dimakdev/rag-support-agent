# Support agent over your own documents (n8n + Qdrant + Gemini + Airtable).
# Copy to .env and fill in. Never commit .env.

# n8n: Settings -> n8n API -> Create an API key
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678

# Where the workflow reaches Qdrant FROM INSIDE n8n.
#   both started by this compose file        -> http://qdrant:6333
#   n8n in Docker, Qdrant published on host  -> http://host.docker.internal:6333
#   n8n installed on the host                -> http://localhost:6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=docs
# Only if the scripts cannot reach Qdrant at the address above with the Docker name swapped for
# localhost — for example when you published it on a different port.
QDRANT_HOST_URL=

# Gemini does two different jobs here: embeddings (turning text into numbers) and the answer itself.
# One key covers both. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Airtable holds what a human looks at: sources, index runs, conversations, tickets, eval runs.
# Token: https://airtable.com/create/tokens
# scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Where a new ticket is announced. Bot token from @BotFather; chat id of the person who answers.
# Optional: leave both empty and the two Telegram nodes are deployed disabled. Tickets are still
# written to Airtable, nobody is pinged about them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret for POST /webhook/ask (header: x-webhook-secret).
# Leave empty and deploy.py generates one and writes it back here.
WEBHOOK_SECRET=
